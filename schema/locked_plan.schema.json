{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fosit:schema:locked_plan:1.0",
  "title": "FOSIT locked plan",
  "description": "Pre-registered geo-experiment plan. Only `commitment` is hashed (SHA-256 over RFC 8785 canonical JSON). `appendix` is optional and can be removed before sharing without changing the hash. See docs/PREREGISTRATION.md.",
  "type": "object",
  "required": [
    "fosit_plan_version",
    "commitment",
    "hash"
  ],
  "additionalProperties": false,
  "properties": {
    "fosit_plan_version": {
      "const": "1.0"
    },
    "commitment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool",
        "created_at",
        "test_name",
        "currency",
        "geo",
        "kpi",
        "dates",
        "cells",
        "control",
        "excluded",
        "method",
        "thresholds",
        "decision",
        "assignment",
        "vendor_targeting_confirmed",
        "data_fingerprint"
      ],
      "properties": {
        "tool": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "version",
            "core_sha256"
          ],
          "properties": {
            "name": {
              "const": "FOSIT"
            },
            "version": {
              "type": "string",
              "description": "Semver of the FOSIT release used."
            },
            "core_sha256": {
              "$ref": "#/$defs/sha256",
              "description": "Hash of the /core Python bundle that ran, so the exact code can be identified."
            }
          }
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "test_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "advertiser_label": {
          "type": "string",
          "maxLength": 200
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "description": "ISO 4217"
        },
        "geo": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "unit",
            "mapping_name",
            "mapping_sha256"
          ],
          "properties": {
            "unit": {
              "enum": [
                "cbsa",
                "state",
                "custom"
              ]
            },
            "mapping_name": {
              "type": "string",
              "description": "e.g. 'Census ZCTA-county 2020 + OMB CBSA 2023' or the user's file name"
            },
            "mapping_sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "kpi": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "primary",
            "secondary",
            "aggregation"
          ],
          "properties": {
            "primary": {
              "enum": [
                "orders",
                "revenue"
              ]
            },
            "secondary": {
              "type": "array",
              "items": {
                "enum": [
                  "orders",
                  "revenue"
                ]
              },
              "uniqueItems": true
            },
            "aggregation": {
              "enum": [
                "daily",
                "weekly"
              ]
            }
          }
        },
        "dates": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pre_start",
            "pre_end",
            "test_start",
            "test_end",
            "cooldown_end"
          ],
          "properties": {
            "pre_start": {
              "$ref": "#/$defs/date"
            },
            "pre_end": {
              "$ref": "#/$defs/date"
            },
            "test_start": {
              "$ref": "#/$defs/date"
            },
            "test_end": {
              "$ref": "#/$defs/date"
            },
            "cooldown_end": {
              "$ref": "#/$defs/date"
            }
          }
        },
        "design": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "description": "Absent = geo_cells (plans from FOSIT 0.1). national_holdout: one cell (the campaign markets) and the control is the holdout; ads_before_test is required. METHODOLOGY.md \u00a713.",
          "properties": {
            "type": {
              "enum": [
                "geo_cells",
                "national_holdout"
              ]
            },
            "ads_before_test": {
              "enum": [
                "off",
                "always_on"
              ],
              "description": "Campaign status in every market during the history period (\u00a713.1)."
            }
          }
        },
        "cells": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label",
              "geo_ids",
              "budget"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^cell_[0-9]+$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "description": "User-chosen. FOSIT attaches no meaning to it."
              },
              "geo_ids": {
                "$ref": "#/$defs/geo_list"
              },
              "budget": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          }
        },
        "control": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "geo_ids"
          ],
          "properties": {
            "geo_ids": {
              "$ref": "#/$defs/geo_list"
            }
          }
        },
        "excluded": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "geo_ids"
          ],
          "properties": {
            "geo_ids": {
              "$ref": "#/$defs/geo_list_or_empty"
            },
            "reasons": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        },
        "method": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "estimator",
            "fixed_effects",
            "lambda_selection",
            "inference",
            "permutations",
            "test_statistic",
            "alpha",
            "report_levels",
            "head_to_head",
            "donor_min_nonzero_share",
            "seed"
          ],
          "properties": {
            "estimator": {
              "const": "ridge_ascm"
            },
            "fixed_effects": {
              "type": "boolean"
            },
            "lambda_selection": {
              "enum": [
                "cv_1se",
                "fixed"
              ]
            },
            "lambda_value": {
              "type": "number",
              "minimum": 0,
              "description": "Required when lambda_selection = fixed."
            },
            "inference": {
              "const": "conformal"
            },
            "permutations": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind"
              ],
              "description": "METHODOLOGY.md \u00a75.5. n and seed apply to iid only.",
              "properties": {
                "kind": {
                  "enum": [
                    "moving_block",
                    "iid"
                  ]
                },
                "n": {
                  "type": "integer",
                  "minimum": 100
                },
                "seed": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "placebo_calibration": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "n"
              ],
              "description": "METHODOLOGY.md \u00a75.6. Check each conformal range against n placebo cells over the same window and report the wider range. Absent = off (plans from FOSIT 0.1).",
              "properties": {
                "n": {
                  "type": "integer",
                  "minimum": 10
                }
              }
            },
            "test_statistic": {
              "enum": [
                "abs_sum",
                "positive_sum",
                "negative_sum"
              ]
            },
            "alpha": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 0.2
            },
            "report_levels": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 1
            },
            "head_to_head": {
              "const": "joint_conformal_projection"
            },
            "donor_min_nonzero_share": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "seed": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "thresholds": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pre_fit_nrmse_max",
            "leakage_warn_share",
            "spend_share_tolerance_pp",
            "min_budget_delivery",
            "power_target"
          ],
          "properties": {
            "pre_fit_nrmse_max": {
              "type": "object",
              "description": "Per cell id, per KPI.",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              }
            },
            "leakage_warn_share": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "spend_share_tolerance_pp": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "min_budget_delivery": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "power_target": {
              "type": "number",
              "exclusiveMinimum": 0,
              "exclusiveMaximum": 1
            }
          }
        },
        "decision": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "primary_metric",
            "meaningful_effect_basis"
          ],
          "properties": {
            "primary_metric": {
              "enum": [
                "delta_icpa",
                "delta_iroas",
                "delta_incremental_per_1000",
                "cell_lift"
              ]
            },
            "meaningful_effect_basis": {
              "enum": [
                "target_icpa",
                "breakeven_iroas",
                "planned_mde"
              ]
            },
            "target_icpa": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "breakeven_iroas": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "planned_mde_lift": {
              "type": "object",
              "additionalProperties": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "description": "Planned minimum detectable lift per cell id (ads-on days). Used as the meaningful effect when meaningful_effect_basis = planned_mde (METHODOLOGY.md \u00a78)."
            }
          }
        },
        "assignment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method",
            "candidates_searched",
            "design_rank",
            "label_assignment"
          ],
          "properties": {
            "method": {
              "const": "stratified_random_search"
            },
            "candidates_searched": {
              "type": "integer",
              "minimum": 1
            },
            "design_rank": {
              "type": "integer",
              "minimum": 1,
              "description": "Rank of the chosen design in the candidate list."
            },
            "label_assignment": {
              "enum": [
                "user",
                "coin_flip"
              ]
            },
            "coin_flip_result": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              },
              "description": "market-set index -> cell id, when coin_flip."
            }
          }
        },
        "vendor_targeting_confirmed": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "cell_id",
              "confirmed"
            ],
            "properties": {
              "cell_id": {
                "type": "string"
              },
              "confirmed": {
                "const": true
              }
            }
          }
        },
        "data_fingerprint": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kpi_history_sha256",
            "rows",
            "geos",
            "first_date",
            "last_date"
          ],
          "properties": {
            "kpi_history_sha256": {
              "$ref": "#/$defs/sha256",
              "description": "Hash of the KPI file used for planning. Reveals nothing about its contents."
            },
            "rows": {
              "type": "integer"
            },
            "geos": {
              "type": "integer"
            },
            "first_date": {
              "$ref": "#/$defs/date"
            },
            "last_date": {
              "$ref": "#/$defs/date"
            }
          }
        }
      }
    },
    "hash": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "canonicalization",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "SHA-256"
        },
        "canonicalization": {
          "const": "RFC8785"
        },
        "value": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "appendix": {
      "type": "object",
      "description": "Design diagnostics (fit, balance, MDE, power curves, share of national). NOT hashed. Remove before sharing if the advertiser prefers not to disclose sales shares.",
      "additionalProperties": true
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "geo_list": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      },
      "description": "Sorted ascending (code-point order)."
    },
    "geo_list_or_empty": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    }
  }
}
