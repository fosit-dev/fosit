{
  "name": "fosit-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "prepare-runtime": "node scripts/fetch-pyodide.mjs && python3 scripts/build_core_bundle.py",
    "dev": "vite",
